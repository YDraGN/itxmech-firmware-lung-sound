# Copy to .env and fill with values supplied privately by the operator.
# scripts/build_config.py reads .env automatically (VS Code Build/Upload work);
# variables already exported in the shell take precedence. Values are never printed.

# ---- production ----
# Optional: leave empty to provision Wi-Fi from the RespiCare-Setup portal.
export WIFI_SSID=''
export WIFI_PASSWORD=''
export DEVICE_ID='RESPICARE-STETH-001'
export MQTT_HOST='mqtt.ndbnguyen.dpdns.org'
export MQTT_PORT='8883'
export MQTT_USERNAME='RESPICARE-STETH-001'
export MQTT_PASSWORD='REPLACE_ME'
export WEB_BASE_URL='https://itxmech-respiratory-web.vercel.app'
export FIRMWARE_DEVICE_API_KEY='REPLACE_ME'
# Exact hostname of the signed Supabase upload URL: no scheme, path or token.
export UPLOAD_HOST='YOUR_PROJECT.supabase.co'
# 5..30 s (one WAV must fit the LittleFS partition).
export RECORD_SECONDS='20'

# ---- microphone DSP (all environments) ----
# Gain over the natural INMP441 level (1 = mic full scale maps to 16-bit full
# scale). 2 matches the ICBHI training recordings (RMS -24..-32 dBFS).
# Lower it if the log warns about overload, raise it if it notes a quiet recording.
export MIC_GAIN='2'
# Band-pass corners (4th-order Butterworth each side). Keep the high-pass low:
# the classifier learned from the strong <150 Hz band of chest-piece audio.
# Lower MIC_LPF_HZ (e.g. 1200) to cut more room speech, at the cost of some
# crackle/wheeze detail.
export MIC_HPF_HZ='20'
export MIC_LPF_HZ='1200'

# ---- stream_udp bench mode (WIFI_SSID/WIFI_PASSWORD above are reused) ----
export UDP_HOST='172.16.0.254'
export UDP_PORT='12345'
